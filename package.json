{
  "name": "oasis-extension",
  "version": "1.0.0",
  "scripts": {
    "build": "webpack --mode production",
    "copy-assets": "copyfiles -u 1 public/manifest.json dist/ && copyfiles -u 1 public/icons/*",
    "tailwind:build": "tailwindcss build src/styles/tailwind.css -i src/styles/tailwind.css -o dist/styles/tailwind.css --minify",
    "start": "npm run build && npm run copy-assets && npm run tailwind:build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^9.2.1",
    "copyfiles": "^2.4.1",
    "css-loader": "^6.7.3",
    "html-webpack-plugin": "^5.5.0",
    "postcss": "^8.4.21",
    "postcss-loader": "^7.0.2",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.3.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
